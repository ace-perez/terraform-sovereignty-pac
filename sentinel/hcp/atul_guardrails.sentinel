# GENERATED by scripts/bundle_sentinel.py from the six policies in sentinel/.
# Do not edit by hand: edit the source policy, then re-run the script.
# Deployed to HCP Terraform Free as ONE hard-mandatory policy, because the
# Free tier allows only one mandatory policy per organisation.

import "tfplan/v2" as tfplan
import "strings"
import "types"
import "tfconfig/v2" as tfconfig

param sov_approved_regions default ["eu-west-1", "eu-central-1"]
param sov_sensitive_regions default ["eu-west-1"]
param sc_approved_provider_sources default ["registry.terraform.io/hashicorp/aws"]
param sc_approved_provider_constraints default ["~> 6.0"]
param sc_approved_terraform_minor default "1.17."
param sc_approved_registry_prefixes default ["terraform-aws-modules/", "app.terraform.io/ATUL00206134/"]
param net_admin_cidrs default ["203.0.113.0/24"]
param net_world_cidrs default ["0.0.0.0/0", "::/0"]
param it_approved_types default ["t3.micro", "t3.small", "t3.medium"]

# ======================================================================
# sovereignty.sentinel
# ======================================================================
# sovereignty.sentinel: Irish digital sovereignty controls.
#   1. Every regional resource is in an approved region (per-resource region, AWS v6).
#   2. Sensitive data stays in eu-west-1. Untagged data counts as sensitive.
#   3. Backup copies only go to Irish vaults.
# Admin access from Irish networks only is checked in network.sentinel.
# Names start with "sov_" for the bundle.



sov_data_types = [
	"aws_s3_bucket",
	"aws_ebs_volume",
	"aws_ebs_snapshot",
	"aws_kms_key",
	"aws_backup_vault",
	"aws_db_instance",
	"aws_rds_cluster",
	"aws_dynamodb_table",
	"aws_efs_file_system",
]

# "<region>", "unknown" (not known at plan time), or "" (global, e.g. IAM).
sov_region = func(rc) {
	r = rc.change.after["region"] else null
	if types.type_of(r) is "string" {
		return r
	}
	unknown = rc.change.after_unknown["region"] else null
	if types.type_of(unknown) is "bool" and unknown {
		return "unknown"
	}
	return ""
}

# DataClassification tag. Missing = "sensitive" (fail closed).
sov_classification = func(rc) {
	for ["tags_all", "tags"] as key {
		tags = rc.change.after[key] else null
		if types.type_of(tags) is "map" {
			c = tags["DataClassification"] else null
			if types.type_of(c) is "string" {
				return strings.to_lower(c)
			}
		}
	}
	return "sensitive"
}

# Backup copy targets outside Ireland. The region is field 4 of the vault ARN.
sov_bad_copies = func(rc) {
	bad = []
	backup_rules = rc.change.after["rule"] else []
	for backup_rules as br {
		copies = br["copy_action"] else []
		for copies as copy {
			arn = copy["destination_vault_arn"] else null
			if types.type_of(arn) is "string" {
				parts = strings.split(arn, ":")
				region = parts[3] else ""
				if region not in sov_sensitive_regions {
					append(bad, arn)
				}
			}
		}
	}
	return bad
}

# Resources being created or updated. Deletes cannot move data anywhere.
sov_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

# ----- 1. approved regions -----------------------------------------------------

sov_region_violations = filter sov_changes as _, rc {
	sov_region(rc) is not "" and sov_region(rc) not in sov_approved_regions
}

for sov_region_violations as address, rc {
	print("SOVEREIGNTY [regions]:", address, "is in", sov_region(rc),
		"| approved:", sov_approved_regions)
}

# ----- 2. data residency for sensitive data ------------------------------------

sov_residency_violations = filter sov_changes as _, rc {
	rc.type in sov_data_types and
		sov_classification(rc) is "sensitive" and
		sov_region(rc) not in sov_sensitive_regions
}

for sov_residency_violations as address, rc {
	print("SOVEREIGNTY [residency]:", address, "holds sensitive data in", sov_region(rc),
		"| allowed:", sov_sensitive_regions)
}

# ----- 3. backup copies --------------------------------------------------------

sov_backup_violations = filter sov_changes as _, rc {
	rc.type is "aws_backup_plan" and length(sov_bad_copies(rc)) > 0
}

for sov_backup_violations as address, rc {
	print("SOVEREIGNTY [backups]:", address, "copies backups to", sov_bad_copies(rc))
}

# ----- rules -------------------------------------------------------------------

sov_regions_ok = rule { length(sov_region_violations) is 0 }
sov_residency_ok = rule { length(sov_residency_violations) is 0 }
sov_backups_ok = rule { length(sov_backup_violations) is 0 }

sovereignty_main = rule { sov_regions_ok and sov_residency_ok and sov_backups_ok }

# ======================================================================
# supply_chain.sentinel
# ======================================================================
# supply_chain.sentinel: IaC supply chain checks at plan time.
#   1. Providers come from an approved source with an approved version constraint.
#      The exact build is pinned by .terraform.lock.hcl, enforced in CI.
#   2. The run uses the approved Terraform minor release.
#   3. Modules are local (reviewed in this repo) or from an approved registry
#      namespace with an exact version.
# Names start with "sc_" for the bundle.



# A map field as a string, "" if missing or not a string.
sc_field = func(m, key) {
	v = m[key] else null
	if types.type_of(v) is "string" {
		return v
	}
	return ""
}

sc_module_ok = func(m) {
	source = sc_field(m, "source")
	if strings.has_prefix(source, "./") or strings.has_prefix(source, "../") {
		return true
	}
	approved = any sc_approved_registry_prefixes as prefix { strings.has_prefix(source, prefix) }
	# Exact version only ("5.2.0" or "= 5.2.0"), no ranges.
	exact = sc_field(m, "version_constraint") matches "^=?\\s*[0-9]+\\.[0-9]+\\.[0-9]+$"
	return approved and exact
}

# ----- 1. providers ------------------------------------------------------------

sc_provider_violations = filter tfconfig.providers as _, p {
	sc_field(p, "full_name") not in sc_approved_provider_sources or
		sc_field(p, "version_constraint") not in sc_approved_provider_constraints
}

for sc_provider_violations as key, p {
	print("SUPPLY CHAIN [provider]:", key, "is", sc_field(p, "full_name"),
		"\"" + sc_field(p, "version_constraint") + "\"",
		"| approved:", sc_approved_provider_sources, sc_approved_provider_constraints)
}

# ----- 2. Terraform version ----------------------------------------------------

sc_terraform_version = tfplan.terraform_version else ""
sc_terraform_version_ok = rule { strings.has_prefix(sc_terraform_version, sc_approved_terraform_minor) }

if not strings.has_prefix(sc_terraform_version, sc_approved_terraform_minor) {
	print("SUPPLY CHAIN [terraform version]:", sc_terraform_version,
		"| approved:", sc_approved_terraform_minor + "x")
}

# ----- 3. modules --------------------------------------------------------------

sc_module_violations = filter tfconfig.module_calls as _, m {
	not sc_module_ok(m)
}

for sc_module_violations as key, m {
	print("SUPPLY CHAIN [module]:", key, "source", sc_field(m, "source"),
		"| must be local, or approved registry with an exact version")
}

# ----- rules -------------------------------------------------------------------

sc_providers_ok = rule { length(sc_provider_violations) is 0 }
sc_modules_ok = rule { length(sc_module_violations) is 0 }

supply_chain_main = rule { sc_providers_ok and sc_terraform_version_ok and sc_modules_ok }

# ======================================================================
# encryption.sentinel
# ======================================================================
# encryption.sentinel: EBS volumes and instance disks must be encrypted.
# An instance that does not declare root_block_device fails (fail closed).
# Names start with "enc_" for the bundle.


enc_list = func(x) {
	if types.type_of(x) is "list" {
		return x
	}
	return []
}

# Only a real boolean true counts. Missing or unknown counts as unencrypted.
enc_on = func(x) {
	return types.type_of(x) is "bool" and x
}

enc_problems = func(rc) {
	after = rc.change.after
	problems = []
	if rc.type is "aws_ebs_volume" {
		v = after["encrypted"] else null
		if not enc_on(v) {
			append(problems, "volume is not encrypted")
		}
	}
	if rc.type is "aws_instance" {
		roots_raw = after["root_block_device"] else null
		extras_raw = after["ebs_block_device"] else null
		roots = enc_list(roots_raw)
		if length(roots) is 0 {
			append(problems, "root_block_device not declared")
		}
		for roots as d {
			v = d["encrypted"] else null
			if not enc_on(v) {
				append(problems, "root volume is not encrypted")
			}
		}
		for enc_list(extras_raw) as d {
			v = d["encrypted"] else null
			if not enc_on(v) {
				append(problems, "extra EBS volume is not encrypted")
			}
		}
	}
	return problems
}

enc_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		rc.type in ["aws_ebs_volume", "aws_instance"] and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

enc_violations = filter enc_changes as _, rc {
	length(enc_problems(rc)) > 0
}

for enc_violations as address, rc {
	print("ENCRYPTION:", address, "|", enc_problems(rc))
}

encryption_main = rule { length(enc_violations) is 0 }

# ======================================================================
# metadata.sentinel
# ======================================================================
# metadata.sentinel: IMDSv2 required (http_tokens = "required") on EC2 instances,
# so an SSRF bug cannot read instance credentials. Not declared = fail.
# Names start with "md_" for the bundle.


md_problem = func(rc) {
	options = rc.change.after["metadata_options"] else null
	if types.type_of(options) is not "list" or length(options) is 0 {
		return "metadata_options not declared, so IMDSv2 is not guaranteed"
	}
	for options as o {
		tokens = o["http_tokens"] else null
		if types.type_of(tokens) is not "string" or tokens is not "required" {
			return "http_tokens is not \"required\""
		}
	}
	return ""
}

md_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		rc.type is "aws_instance" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

md_violations = filter md_changes as _, rc {
	md_problem(rc) is not ""
}

for md_violations as address, rc {
	print("IMDSv2:", address, "|", md_problem(rc))
}

metadata_main = rule { length(md_violations) is 0 }

# ======================================================================
# network.sentinel
# ======================================================================
# network.sentinel: network security baseline.
#   1. Ingress is only written as aws_vpc_security_group_ingress_rule. The other two
#      forms (inline ingress blocks, aws_security_group_rule) are rejected, so they
#      cannot be used to slip a rule past checks 2 and 3.
#   2. SSH (22) and RDP (3389) only from approved Irish admin networks.
#   3. No all-traffic ingress from the internet.
#   4. No public IPs on instances.
# Names start with "net_" for the bundle.



net_str = func(x) {
	if types.type_of(x) is "string" {
		return x
	}
	return ""
}

net_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

net_rules = filter net_changes as _, rc {
	rc.type is "aws_vpc_security_group_ingress_rule"
}

net_protocol = func(rc) {
	p = rc.change.after["ip_protocol"] else null
	return strings.to_lower(net_str(p))
}

net_source = func(rc) {
	v4 = rc.change.after["cidr_ipv4"] else null
	v6 = rc.change.after["cidr_ipv6"] else null
	if net_str(v4) is not "" {
		return v4
	}
	return net_str(v6)
}

net_opens_port = func(rc, port) {
	if net_protocol(rc) in ["-1", "all"] {
		return true
	}
	if net_protocol(rc) not in ["tcp", "6"] {
		return false
	}
	lo = rc.change.after["from_port"] else null
	hi = rc.change.after["to_port"] else null
	# A port range we cannot read is treated as open (fail closed).
	if types.type_of(lo) not in ["int", "float"] or types.type_of(hi) not in ["int", "float"] {
		return true
	}
	return lo <= port and hi >= port
}

# ----- 1. one way to write ingress ---------------------------------------------

net_has_inline_ingress = func(rc) {
	blocks = rc.change.after["ingress"] else null
	return types.type_of(blocks) is "list" and length(blocks) > 0
}

net_form_violations = filter net_changes as _, rc {
	rc.type is "aws_security_group_rule" or
		(rc.type is "aws_security_group" and net_has_inline_ingress(rc))
}

for net_form_violations as address, rc {
	print("NETWORK [rule form]:", address, "| use aws_vpc_security_group_ingress_rule instead")
}

# ----- 2. SSH and RDP only from approved admin networks ------------------------

net_admin_violations = filter net_rules as _, rc {
	(net_opens_port(rc, 22) or net_opens_port(rc, 3389)) and
		net_source(rc) not in net_admin_cidrs
}

for net_admin_violations as address, rc {
	print("NETWORK [SSH/RDP]:", address, "opens SSH/RDP to", net_source(rc),
		"| approved admin networks:", net_admin_cidrs)
}

# ----- 3. all traffic from the internet ----------------------------------------

net_all_traffic_violations = filter net_rules as _, rc {
	net_protocol(rc) in ["-1", "all"] and net_source(rc) in net_world_cidrs
}

for net_all_traffic_violations as address, rc {
	print("NETWORK [all traffic]:", address, "allows every port from", net_source(rc))
}

# ----- 4. public IPs on instances ----------------------------------------------

net_public_ip = func(rc) {
	v = rc.change.after["associate_public_ip_address"] else null
	return types.type_of(v) is "bool" and v
}

net_public_ip_violations = filter net_changes as _, rc {
	rc.type is "aws_instance" and net_public_ip(rc)
}

for net_public_ip_violations as address, rc {
	print("NETWORK [public IP]:", address, "would get a public IP address")
}

# ----- rules -------------------------------------------------------------------

net_form_ok = rule { length(net_form_violations) is 0 }
net_admin_ok = rule { length(net_admin_violations) is 0 }
net_all_traffic_ok = rule { length(net_all_traffic_violations) is 0 }
net_public_ip_ok = rule { length(net_public_ip_violations) is 0 }

network_main = rule { net_form_ok and net_admin_ok and net_all_traffic_ok and net_public_ip_ok }

# ======================================================================
# instance_type.sentinel
# ======================================================================
# instance_type.sentinel: only approved EC2 instance types.
# A type unknown at plan time fails (fail closed). Names start with "it_" for the bundle.



it_type = func(rc) {
	t = rc.change.after["instance_type"] else null
	if types.type_of(t) is "string" {
		return t
	}
	return "unknown"
}

it_changes = filter tfplan.resource_changes as _, rc {
	rc.mode is "managed" and
		rc.type is "aws_instance" and
		(rc.change.actions contains "create" or rc.change.actions contains "update")
}

it_violations = filter it_changes as _, rc {
	it_type(rc) not in it_approved_types
}

for it_violations as address, rc {
	print("INSTANCE TYPE:", address, "is", it_type(rc), "| approved:", it_approved_types)
}

instance_type_main = rule { length(it_violations) is 0 }

main = rule {
	sovereignty_main and
	supply_chain_main and
	encryption_main and
	metadata_main and
	network_main and
	instance_type_main
}
