# HCP Terraform Free deployment: the six policies merged into one, because the
# Free tier allows only one soft- or hard-mandatory policy per organisation.
# Generated by scripts/bundle_sentinel.py. Paste atul_guardrails.sentinel into
# HCP (Settings > Policies) with enforcement level hard-mandatory.

policy "atul_guardrails" {
  source            = "./atul_guardrails.sentinel"
  enforcement_level = "hard-mandatory"
}
